# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored (via `*.local` rule in .gitignore).
# For production, set these same keys in Vercel → Settings → Environment Variables.
#
# See `dashboard-backend/SETUP.md` for how to get the API URL and token.

# Google Apps Script Web App URL (ends with /exec)
DASHBOARD_API_URL=

# Shared secret token — must match API_TOKEN in dashboard-backend/Code.gs
DASHBOARD_API_TOKEN=

# Password for the dashboard UI gate (optional — leave blank to disable the gate)
DASHBOARD_PASSWORD=